# .env.example
# Copy this file to .env and replace placeholders with actual keys.
# DO NOT commit .env to version control.

# LLM Provider Configuration
# Set the provider and model in the LLM roles below.

# API Keys (set only the ones you use)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Self-hosting network. Compose consumes both values; direct host execution only
# uses AGENT_OS_CORS_ORIGINS.
AGENT_OS_API_BASE=http://127.0.0.1:4680
AGENT_OS_CORS_ORIGINS=http://127.0.0.1:4100

# Optional public concierge facade for external website chat widgets. Keep this
# disabled unless you provide an approved public profile and a real public edge.
# AGENT_OS_PUBLIC_CONCIERGE_PATH="./public-concierge.json"
# AGENT_OS_PUBLIC_CONCIERGE_RATE_LIMIT="20"
# AGENT_OS_PUBLIC_CONCIERGE_ADMIN_TOKEN=""

# The runtime reads exactly these three model roles.
# API/local models use LiteLLM provider/model format.
LLM_ROUTER="ollama/qwen2.5:14b"
LLM_ARCHITECT="anthropic/claude-opus-4-8"
LLM_EXECUTOR="openai/gpt-5.5"

# --- Subscription CLI backends ---
# Require the corresponding binary on PATH and authentication before startup.
# Claude-only: set both roles to cli/claude-code.
# Codex-only: set both roles to cli/codex.
# Mixed example:
# LLM_ARCHITECT=cli/claude-code
# LLM_EXECUTOR=cli/codex

# Workspace Configuration
AGENT_OS_WORKSPACE="."
# Direct host execution uses this path. Compose deliberately overrides it to the
# mounted /workspace directory.
AGENT_OS_SANDBOX="/workspace"

# Durable LangGraph checkpoints for direct host execution. Compose overrides
# this with /data/checkpoints.db in the named persistent volume.
AGENT_OS_CHECKPOINTS_DB="./checkpoints.db"
# AGENT_OS_SCHED_DB="./checkpoints.sched.db"

# Scheduler runtime
AGENT_OS_SCHEDULER_ENABLED="true"
AGENT_OS_SCHED_TICK_SECONDS="1"

# MCP integrations
MCP_FILESYSTEM_ENABLED="false"
MCP_CODEGRAPH_ENABLED="false"
MCP_CODEGRAPH_COMMAND="codegraph"
MCP_GBRAIN_URL=""
